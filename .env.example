# Copy this file to ".env" and fill in real values.
# ".env" is never saved to version control. This example file contains no real values.

# Where the PostgreSQL database is.
# Local development with Postgres.app (no password needed):
#   postgresql://YOUR_MAC_USERNAME@localhost:5432/kuchpos_dev
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/kuchpos_dev"

# Separate database used only by automated tests (wiped on every test run).
# Its name must end in "_test".
TEST_DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/kuchpos_test"

# Login system. The secret signs session cookies; keep it private.
# Create one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-value"
# The address people type to reach the app.
BETTER_AUTH_URL="http://localhost:3000"

# Password given to every SAMPLE user created by "npm run db:seed".
# Sample users exist only in development and on the test site — never in the live system.
SEED_PASSWORD="sample-password-123"
