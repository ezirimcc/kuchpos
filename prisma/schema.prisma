// KuchPos database structure.
// Change this file, then run `npm run db:migrate` to create a migration. Never edit an applied migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// OWNER sits above all businesses. The other five roles belong to exactly one business.
enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
  STOREKEEPER
}

/// One independent shop. Everything a shop owns carries its businessId.
model Business {
  id            String    @id @default(uuid()) @db.Char(36)
  name          String
  /// Lower-cased name, used to stop two businesses having the same name.
  nameKey       String    @unique
  /// Set when an owner deactivates the business: nobody can sign in to it, records are kept.
  deactivatedAt DateTime? @db.DateTime(3)
  /// Staff are signed out after this many minutes without using the app (5 to 480; database CHECK).
  idleSignOutMinutes Int  @default(30)
  /// Tax rate in percent (0 to 100; database CHECK). Prices already include tax.
  taxRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  /// Lines printed at the top of every receipt, under the business name (address, phone…).
  receiptHeader String?   @db.VarChar(500)
  /// Lines printed at the bottom of every receipt (thank-you note, return policy…).
  receiptFooter String?   @db.VarChar(500)
  /// The business's tax number (TIN). Printed on receipts only when filled in.
  taxNumber     String?   @db.VarChar(40)
  /// How many months ahead an expiry date counts as "expiring soon" (1 to 36; database CHECK).
  expiringSoonMonths Int  @default(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  users         User[]
  activityLogs  ActivityLog[]
  openedIn      Session[]
  locations     Location[]
  terminals     Terminal[]
  products      Product[]
  categories    Category[]
  productUnits  ProductUnit[]
  priceChanges  PriceChange[]
  taxRateChanges TaxRateChange[]
  suppliers     Supplier[]
  receiptVersions GoodsReceiptVersion[]
  receiptVersionLines GoodsReceiptVersionLine[]
  receiptChanges GoodsReceiptChange[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  goodsReceipts GoodsReceipt[]
  goodsReceiptLines GoodsReceiptLine[]
  stockTransfers StockTransfer[]
  stockTransferLines StockTransferLine[]
  stockCounts StockCount[]
  stockCountLines StockCountLine[]
  stockAdjustments StockAdjustment[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockAdjustmentDecisions StockAdjustmentDecision[]
  documentCounters DocumentCounter[]
  paymentMethods PaymentMethod[]
  tillSessions  TillSession[]
  tillSessionCloses TillSessionClose[]
  tillSessionRecounts TillSessionRecount[]
  saleCancellations SaleCancellation[]
  refunds       Refund[]
  customers     Customer[]
  customerAccountEntries CustomerAccountEntry[]
  creditLimitChanges CreditLimitChange[]
  repayments    Repayment[]
  repaymentAllocations RepaymentAllocation[]
  approvals     Approval[]
  approvalUses  ApprovalUse[]
  approvalRequests ApprovalRequest[]
  approvalRequestDecisions ApprovalRequestDecision[]
  sales         Sale[]
  saleLines     SaleLine[]
  payments      Payment[]
  receiptPrints SaleReceiptPrint[]

  @@map("business")
}

/// A person who can sign in. Core columns are required by the Better Auth login library.
model User {
  id              String    @id
  name            String
  /// Not used for sign-in or contact; the login library requires a unique value here.
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  /// Sign-in name. Unique across the whole system, always lower case.
  username        String    @unique
  displayUsername String?

  role            Role
  /// Empty for owners; set for everyone else (enforced by a database CHECK).
  businessId      String?   @db.Char(36)
  /// onUpdate must be Restrict: MariaDB refuses a CHECK on a column whose foreign key cascades.
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Set when the account is disabled. Accounts are never deleted.
  disabledAt      DateTime? @db.DateTime(3)

  sessions        Session[]
  accounts        Account[]
  activityLogs    ActivityLog[]
  priceChanges    PriceChange[]
  taxRateChanges  TaxRateChange[]

  @@index([businessId])
  @@map("user")
}

/// A signed-in browser. Core columns are required by the login library.
model Session {
  id               String    @id
  expiresAt        DateTime  @db.DateTime(3)
  token            String    @unique
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)
  ipAddress        String?
  userAgent        String?   @db.Text
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When this session last made a request. Used for automatic sign-out after inactivity.
  lastActiveAt     DateTime  @default(now()) @db.DateTime(3)

  /// For owners only: the business they currently have open.
  activeBusinessId String?   @db.Char(36)
  activeBusiness   Business? @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("session")
}

/// A way of signing in for a user. KuchPos uses only "credential" (username + password).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?
  /// Scrambled (hashed) password. Never readable.
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Required by the login library; unused by KuchPos today.
model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}

/// Counts recent requests per visitor so that password guessing can be slowed down.
/// Managed entirely by the login library.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Who did what and when. Add-only: database triggers refuse changes and deletions.
model ActivityLog {
  id          String    @id @default(uuid()) @db.Char(36)
  /// The business the event belongs to. Empty for system-level events (owners, creating businesses).
  businessId  String?   @db.Char(36)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  /// Copies of the actor's name and role at the time, so the log still reads correctly later.
  actorName   String
  actorRole   Role?
  /// Machine-readable event name, e.g. "staff.created".
  action      String
  /// Plain-language sentence shown on screen.
  summary     String    @db.VarChar(500)
  targetType  String?
  targetId    String?
  details     Json?
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([businessId, createdAt])
  @@map("activity_log")
}

enum LocationKind {
  SHELF
  STOREROOM
}

/// A place inside one business where stock is kept. Every business starts with a Shelf and a Storeroom.
model Location {
  id         String       @id @default(uuid()) @db.Char(36)
  businessId String       @db.Char(36)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name       String       @db.VarChar(60)
  kind       LocationKind
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)

  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  goodsReceipts  GoodsReceipt[]
  stockCounts    StockCount[]
  stockAdjustments StockAdjustment[]
  saleLines      SaleLine[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@unique([businessId, name])
  @@map("location")
}

enum PaperWidth {
  MM58
  MM80
}

/// A checkout computer. Its short code starts every receipt number it produces.
model Terminal {
  id            String     @id @default(uuid()) @db.Char(36)
  businessId    String     @db.Char(36)
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Short code, capital letters and digits, unique within the business (e.g. "T1"). Never changes.
  code          String     @db.VarChar(6)
  name          String     @db.VarChar(60)
  paperWidth    PaperWidth @default(MM80)
  /// The running number the next receipt from this terminal will get. Only ever increased.
  nextReceiptNumber Int    @default(1)
  deactivatedAt DateTime?  @db.DateTime(3)
  createdAt     DateTime   @default(now()) @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @db.DateTime(3)

  sales         Sale[]
  tillSessions  TillSession[]

  @@unique([businessId, code])
  @@map("terminal")
}

/// Something the business sells. Stock is always counted in the product's base unit.
model Product {
  id             String    @id @default(uuid()) @db.Char(36)
  businessId     String    @db.Char(36)
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name           String    @db.VarChar(120)
  /// Optional short code used by the shop. Unique within the business when present.
  code           String?   @db.VarChar(40)
  /// Optional barcode. Unique within the business when present.
  barcode        String?   @db.VarChar(64)
  /// Optional category (Seeds, Fertilizers…), from the business's own list.
  categoryId     String?   @db.Char(36)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// True for goods sold by weight or volume (2.5 kg); false for goods sold only in whole units.
  /// Fixed when the product is created.
  allowsFraction Boolean
  /// Unticked products carry no tax whatever the business's tax rate.
  taxable        Boolean   @default(true)
  /// Ticked when deliveries of this product must give a batch number / an expiry date.
  tracksBatch    Boolean   @default(false)
  tracksExpiry   Boolean   @default(false)
  /// Moving weighted average cost of ONE base unit, updated on every delivery.
  averageCost    Decimal   @default(0) @db.Decimal(16, 4)
  /// Set when the product is taken out of use. Products are never deleted.
  deactivatedAt  DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  units          ProductUnit[]
  priceChanges   PriceChange[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  stockTransferLines StockTransferLine[]
  stockCountLines StockCountLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  saleLines      SaleLine[]
  receiptLines   GoodsReceiptLine[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, barcode])
  @@index([businessId, categoryId])
  @@map("product")
}

/// A grouping of products chosen by the business, for example Seeds or Fertilizers.
model Category {
  id         String   @id @default(uuid()) @db.Char(36)
  businessId String   @db.Char(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name       String   @db.VarChar(60)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  products   Product[]

  @@unique([businessId, name])
  @@map("category")
}

/// A unit a product is bought or sold in (single, pack, carton, kg, 50 kg bag…), with its own price.
/// The name and conversion of a unit never change: to change them, the unit is retired and a new one added.
model ProductUnit {
  id          String    @id @default(uuid()) @db.Char(36)
  businessId  String    @db.Char(36)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId   String    @db.Char(36)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name        String    @db.VarChar(40)
  /// How many base units one of this unit contains. The base unit itself is 1.
  factor      Decimal   @db.Decimal(12, 3)
  isBase      Boolean   @default(false)
  forSale     Boolean   @default(true)
  forPurchase Boolean   @default(true)
  /// Selling price in Naira, tax included. Empty when the unit is not for sale.
  price       Decimal?  @db.Decimal(14, 2)
  /// The unit's name while it is in use, empty once retired. Stops two in-use units of one
  /// product sharing a name while still allowing a retired "carton" beside a new "carton".
  activeName  String?   @db.VarChar(40)
  retiredAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  priceChanges PriceChange[]
  receiptLines GoodsReceiptLine[]

  @@unique([productId, activeName])
  @@index([businessId])
  @@map("product_unit")
}

/// Every change of a selling price. Add-only: database triggers refuse changes and deletions.
model PriceChange {
  id              String      @id @default(uuid()) @db.Char(36)
  businessId      String      @db.Char(36)
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId       String      @db.Char(36)
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId   String      @db.Char(36)
  productUnit     ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Copy of the unit's name at the time.
  unitName        String      @db.VarChar(40)
  /// Empty when this is the unit's first price.
  oldPrice        Decimal?    @db.Decimal(14, 2)
  /// Empty when the price was removed because the unit stopped being for sale.
  newPrice        Decimal?    @db.Decimal(14, 2)
  changedByUserId String?
  changedBy       User?       @relation(fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByName   String
  createdAt       DateTime    @default(now()) @db.DateTime(3)

  @@index([productId, createdAt])
  @@map("price_change")
}

/// Every change of a business's tax rate. Add-only: database triggers refuse changes and deletions.
model TaxRateChange {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  oldRatePercent  Decimal  @db.Decimal(5, 2)
  newRatePercent  Decimal  @db.Decimal(5, 2)
  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByName   String
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, createdAt])
  @@map("tax_rate_change")
}

/// A company or person the business buys goods from.
model Supplier {
  id            String    @id @default(uuid()) @db.Char(36)
  businessId    String    @db.Char(36)
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String    @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  note          String?   @db.VarChar(300)
  deactivatedAt DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  goodsReceipts GoodsReceipt[]

  @@unique([businessId, name])
  @@map("supplier")
}

/// How much of a product is in one location right now, in base units.
/// A convenience: it must always equal the sum of that product's stock movements there.
/// The database refuses a negative quantity.
model StockBalance {
  id         String   @id @default(uuid()) @db.Char(36)
  businessId String   @db.Char(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId  String   @db.Char(36)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationId String   @db.Char(36)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quantity   Decimal  @default(0) @db.Decimal(16, 3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@unique([productId, locationId])
  @@index([businessId])
  @@map("stock_balance")
}

enum StockMovementType {
  RECEIPT
  /// The stock effect of correcting a saved delivery: positive or negative.
  RECEIPT_CORRECTION
  /// The two halves of a transfer: out of one location (negative), into the other (positive).
  TRANSFER_OUT
  TRANSFER_IN
  /// Stock added to or taken from a location by an applied adjustment.
  ADJUSTMENT
  /// Stock leaving a location because it was sold.
  SALE
  /// Stock coming back because the sale was cancelled.
  SALE_CANCELLATION
}

/// Every change to stock. Add-only: database triggers refuse changes and deletions.
/// A mistake is corrected by a new, opposite movement.
model StockMovement {
  id             String            @id @default(uuid()) @db.Char(36)
  businessId     String            @db.Char(36)
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId      String            @db.Char(36)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationId     String            @db.Char(36)
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type           StockMovementType
  /// Change in base units: positive when stock arrives, negative when it leaves. Never zero.
  quantityDelta  Decimal           @db.Decimal(16, 3)
  /// Copies of the unit the person chose, as it was at the time.
  unitName       String            @db.VarChar(40)
  unitFactor     Decimal           @db.Decimal(12, 3)
  unitQuantity   Decimal           @db.Decimal(16, 3)
  /// The document this movement belongs to.
  documentType   String            @db.VarChar(30)
  documentId     String            @db.Char(36)
  documentNumber String            @db.VarChar(30)
  userId         String?
  userName       String
  createdAt      DateTime          @default(now()) @db.DateTime(3)

  @@index([productId, createdAt])
  @@index([businessId, createdAt])
  @@index([documentId])
  @@map("stock_movement")
}

/// A delivery from a supplier, as it stands NOW. It is never deleted. It changes only through a
/// correction, which raises `version` by one and keeps a full unchangeable snapshot of every
/// version (the original included) in GoodsReceiptVersion. A database trigger refuses any
/// update that does not raise the version by exactly one, or that touches its identity.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up by the browser before sending, so the same submission can never be saved twice.
  requestId       String   @db.Char(36)
  /// Running number within the business (shown as GR-000001).
  number          Int
  supplierId      String   @db.Char(36)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierName    String   @db.VarChar(120)
  locationId      String   @db.Char(36)
  location        Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationName    String   @db.VarChar(60)
  /// The day the goods arrived, in the shop's calendar.
  receivedOn      DateTime @db.Date
  /// True when receivedOn is earlier than the day it was entered; a note is then required.
  backdated       Boolean  @default(false)
  backdateNote    String?  @db.VarChar(300)
  invoiceNumber   String?  @db.VarChar(60)
  note            String?  @db.VarChar(300)
  totalCost       Decimal  @db.Decimal(16, 2)
  createdByUserId String?
  createdByName   String
  /// When it was entered (server time).
  createdAt       DateTime @default(now()) @db.DateTime(3)
  /// 1 for a delivery as first saved; raised by one on every correction.
  version         Int      @default(1)

  lines           GoodsReceiptLine[]
  versions        GoodsReceiptVersion[]
  changes         GoodsReceiptChange[]

  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([businessId, receivedOn])
  @@map("goods_receipt")
}

/// One product on a delivery as it stands NOW, with copies of the unit, conversion and cost.
/// Rewritten by a correction; what it used to say is kept in GoodsReceiptVersionLine.
model GoodsReceiptLine {
  id            String       @id @default(uuid()) @db.Char(36)
  businessId    String       @db.Char(36)
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiptId     String       @db.Char(36)
  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber    Int
  productId     String       @db.Char(36)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId String       @db.Char(36)
  productUnit   ProductUnit  @relation(fields: [productUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productName   String       @db.VarChar(120)
  unitName      String       @db.VarChar(40)
  unitFactor    Decimal      @db.Decimal(12, 3)
  /// How many of the chosen unit arrived, and the same amount in base units.
  quantity      Decimal      @db.Decimal(16, 3)
  baseQuantity  Decimal      @db.Decimal(16, 3)
  /// Cost of one of the chosen unit, and of the whole line.
  unitCost      Decimal      @db.Decimal(14, 2)
  lineCost      Decimal      @db.Decimal(16, 2)
  batchNumber   String?      @db.VarChar(60)
  expiryDate    DateTime?    @db.Date

  @@unique([receiptId, lineNumber])
  @@index([businessId, expiryDate])
  @@index([productId])
  @@map("goods_receipt_line")
}

/// A complete snapshot of a delivery at one version. Version 1 is the delivery as first saved;
/// each correction adds the next. Add-only: database triggers refuse changes and deletions,
/// so the original and every later state can always be shown exactly as they were.
model GoodsReceiptVersion {
  id              String       @id @default(uuid()) @db.Char(36)
  businessId      String       @db.Char(36)
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiptId       String       @db.Char(36)
  receipt         GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version         Int
  /// Made up by the browser for a correction, so the same correction is never applied twice.
  requestId       String?      @db.Char(36)
  /// Why the correction was made. Empty only for version 1.
  reason          String?      @db.VarChar(300)
  supplierId      String       @db.Char(36)
  supplierName    String       @db.VarChar(120)
  locationId      String       @db.Char(36)
  locationName    String       @db.VarChar(60)
  receivedOn      DateTime     @db.Date
  invoiceNumber   String?      @db.VarChar(60)
  note            String?      @db.VarChar(300)
  totalCost       Decimal      @db.Decimal(16, 2)
  /// Who saved this version, and when (server time).
  createdByUserId String?
  createdByName   String
  createdAt       DateTime     @default(now()) @db.DateTime(3)

  lines           GoodsReceiptVersionLine[]
  changes         GoodsReceiptChange[]

  @@unique([receiptId, version])
  @@unique([businessId, requestId])
  @@map("goods_receipt_version")
}

/// One line of a delivery snapshot. Add-only.
model GoodsReceiptVersionLine {
  id            String              @id @default(uuid()) @db.Char(36)
  businessId    String              @db.Char(36)
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionId     String              @db.Char(36)
  version       GoodsReceiptVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber    Int
  productId     String              @db.Char(36)
  productUnitId String              @db.Char(36)
  productName   String              @db.VarChar(120)
  unitName      String              @db.VarChar(40)
  unitFactor    Decimal             @db.Decimal(12, 3)
  quantity      Decimal             @db.Decimal(16, 3)
  baseQuantity  Decimal             @db.Decimal(16, 3)
  unitCost      Decimal             @db.Decimal(14, 2)
  lineCost      Decimal             @db.Decimal(16, 2)
  batchNumber   String?             @db.VarChar(60)
  expiryDate    DateTime?           @db.Date

  @@unique([versionId, lineNumber])
  @@map("goods_receipt_version_line")
}

/// One changed field in one correction: what it was and what it became. Add-only.
model GoodsReceiptChange {
  id          String              @id @default(uuid()) @db.Char(36)
  businessId  String              @db.Char(36)
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiptId   String              @db.Char(36)
  receipt     GoodsReceipt        @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// The version this change produced (2 or higher).
  versionId   String              @db.Char(36)
  version     GoodsReceiptVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Order within the correction, for showing changes in a steady order.
  position    Int
  /// Empty for a change to the delivery as a whole; the line number for a change to one line.
  lineNumber  Int?
  productName String?             @db.VarChar(120)
  /// Machine name of what changed (supplier, quantity, unitCost, lineAdded…), and its label for people.
  field       String              @db.VarChar(40)
  label       String              @db.VarChar(60)
  /// The value before and after, written for people ("2 carton", "₦30,000.00"). Empty means "nothing".
  oldValue    String?             @db.VarChar(400)
  newValue    String?             @db.VarChar(400)

  @@index([receiptId])
  @@index([versionId, position])
  @@map("goods_receipt_change")
}

/// Stock moved from one location of a business to its other location. Add-only: once saved
/// it is never changed or deleted; a mistake is put right with a transfer the other way.
model StockTransfer {
  id               String   @id @default(uuid()) @db.Char(36)
  businessId       String   @db.Char(36)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up by the browser, so the same transfer is never saved twice.
  requestId        String   @db.Char(36)
  /// 1, 2, 3… within the business; shown as TR-000012.
  number           Int
  fromLocationId   String   @db.Char(36)
  fromLocation     Location @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromLocationName String   @db.VarChar(60)
  toLocationId     String   @db.Char(36)
  toLocation       Location @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toLocationName   String   @db.VarChar(60)
  note             String?  @db.VarChar(300)
  createdByUserId  String?
  createdByName    String
  createdAt        DateTime @default(now()) @db.DateTime(3)

  lines            StockTransferLine[]

  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([businessId, createdAt])
  @@map("stock_transfer")
}

/// One product on a transfer, with copies of the unit and conversion as they were. Add-only.
model StockTransferLine {
  id            String        @id @default(uuid()) @db.Char(36)
  businessId    String        @db.Char(36)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transferId    String        @db.Char(36)
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber    Int
  productId     String        @db.Char(36)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId String        @db.Char(36)
  productName   String        @db.VarChar(120)
  unitName      String        @db.VarChar(40)
  unitFactor    Decimal       @db.Decimal(12, 3)
  /// How many of the chosen unit, and the same amount in base units.
  quantity      Decimal       @db.Decimal(16, 3)
  baseQuantity  Decimal       @db.Decimal(16, 3)

  @@unique([transferId, lineNumber])
  @@index([productId])
  @@map("stock_transfer_line")
}

/// What staff physically counted in one location, with what the system expected at the moment
/// the count was saved. Add-only: a count is evidence and is never changed or deleted.
model StockCount {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up by the browser, so the same count is never saved twice.
  requestId       String   @db.Char(36)
  /// 1, 2, 3… within the business; shown as SC-000012.
  number          Int
  locationId      String   @db.Char(36)
  location        Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationName    String   @db.VarChar(60)
  /// What the sheet was narrowed to: a category's name, or empty for all products.
  categoryName    String?  @db.VarChar(60)
  note            String?  @db.VarChar(300)
  createdByUserId String?
  createdByName   String
  createdAt       DateTime @default(now()) @db.DateTime(3)

  lines           StockCountLine[]
  adjustment      StockAdjustment?

  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([businessId, createdAt])
  @@map("stock_count")
}

/// One counted product. Quantities are in base units. Add-only.
model StockCountLine {
  id               String     @id @default(uuid()) @db.Char(36)
  businessId       String     @db.Char(36)
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  countId          String     @db.Char(36)
  count            StockCount @relation(fields: [countId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber       Int
  productId        String     @db.Char(36)
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productName      String     @db.VarChar(120)
  baseUnitId       String     @db.Char(36)
  baseUnitName     String     @db.VarChar(40)
  /// How it was entered, for people: "2 carton + 7 single".
  enteredAs        String     @db.VarChar(200)
  countedQuantity  Decimal    @db.Decimal(16, 3)
  /// What the system held in this location at the moment the count was saved.
  expectedQuantity Decimal    @db.Decimal(16, 3)
  /// Counted minus expected: negative means stock is missing.
  difference       Decimal    @db.Decimal(16, 3)

  @@unique([countId, lineNumber])
  @@unique([countId, productId])
  @@index([productId])
  @@map("stock_count_line")
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  MISSING
  COUNT_ERROR
  FOUND
  SAMPLE_GIFT
  DATA_ENTRY_ERROR
  OTHER
}

enum AdjustmentOutcome {
  APPLIED
  REJECTED
}

/// A request to add stock to, or take stock from, one location. Add-only. It changes stock
/// only when a decision with outcome APPLIED exists for it (StockAdjustmentDecision); until
/// a decision exists it is waiting for approval.
model StockAdjustment {
  id              String      @id @default(uuid()) @db.Char(36)
  businessId      String      @db.Char(36)
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up by the browser, so the same adjustment is never saved twice.
  requestId       String      @db.Char(36)
  /// 1, 2, 3… within the business; shown as AD-000012.
  number          Int
  locationId      String      @db.Char(36)
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationName    String      @db.VarChar(60)
  /// The count whose differences this adjustment corrects, if it came from one. One adjustment per count.
  countId         String?     @unique @db.Char(36)
  count           StockCount? @relation(fields: [countId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  note            String?     @db.VarChar(300)
  createdByUserId String?
  createdByName   String
  createdAt       DateTime    @default(now()) @db.DateTime(3)

  lines           StockAdjustmentLine[]
  decision        StockAdjustmentDecision?

  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([businessId, createdAt])
  @@map("stock_adjustment")
}

/// One product on an adjustment. Quantities are signed: negative takes stock out. Add-only.
model StockAdjustmentLine {
  id            String           @id @default(uuid()) @db.Char(36)
  businessId    String           @db.Char(36)
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adjustmentId  String           @db.Char(36)
  adjustment    StockAdjustment  @relation(fields: [adjustmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber    Int
  productId     String           @db.Char(36)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId String           @db.Char(36)
  productName   String           @db.VarChar(120)
  unitName      String           @db.VarChar(40)
  unitFactor    Decimal          @db.Decimal(12, 3)
  /// The change in the chosen unit, and the same change in base units. Never zero.
  quantity      Decimal          @db.Decimal(16, 3)
  baseQuantity  Decimal          @db.Decimal(16, 3)
  reason        AdjustmentReason

  @@unique([adjustmentId, lineNumber])
  @@index([productId])
  @@map("stock_adjustment_line")
}

/// The one decision on an adjustment: applied (stock changed in the same transaction) or
/// rejected. For an admin's or manager's own adjustment it is written at once. Add-only.
model StockAdjustmentDecision {
  id              String            @id @default(uuid()) @db.Char(36)
  businessId      String            @db.Char(36)
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adjustmentId    String            @unique @db.Char(36)
  adjustment      StockAdjustment   @relation(fields: [adjustmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outcome         AdjustmentOutcome
  note            String?           @db.VarChar(300)
  decidedByUserId String?
  decidedByName   String
  createdAt       DateTime          @default(now()) @db.DateTime(3)

  @@index([businessId, outcome])
  @@map("stock_adjustment_decision")
}

/// A completed sale. Add-only: it is never changed or deleted; a mistake is put right later
/// by a void or a return. Every amount is stored as it was worked out at the moment of sale.
model Sale {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up on the cashier's computer before the sale is sent, so it is never saved twice.
  requestId       String   @db.Char(36)
  terminalId      String   @db.Char(36)
  terminal        Terminal @relation(fields: [terminalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terminalCode    String   @db.VarChar(6)
  /// The terminal's running number, and the receipt number built from it: "T1-000012".
  sequence        Int
  receiptNumber   String   @db.VarChar(20)
  /// What the customer owed: the sum of the lines less any discount. Tax is already inside it.
  total           Decimal  @db.Decimal(14, 2)
  /// An extra discount on the whole sale, in Naira, with the percentage it was typed as (if it
  /// was) and the reason given. Shared out over the lines in SaleLine.discountAmount.
  discountAmount  Decimal  @default(0) @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountReason  String?  @db.VarChar(300)
  /// The business's tax rate at the moment of sale, and the tax contained in the total.
  taxRatePercent  Decimal  @db.Decimal(5, 2)
  taxTotal        Decimal  @db.Decimal(14, 2)
  /// What the goods cost the business (average cost at the moment of sale), for profit reports.
  costTotal       Decimal  @db.Decimal(16, 2)
  cashierUserId   String?
  cashierName     String
  /// The clock of the cashier's computer when the sale was made (matters for offline sales).
  deviceTime      DateTime? @db.DateTime(3)
  /// Server time when it was saved.
  createdAt       DateTime @default(now()) @db.DateTime(3)
  /// The customer it was sold to, with their name and phone as they were. Empty for a walk-in.
  customerId      String?  @db.Char(36)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerName    String?  @db.VarChar(120)
  customerPhone   String?  @db.VarChar(30)
  /// The part of the total put on the customer's account instead of being paid now.
  creditAmount    Decimal  @default(0) @db.Decimal(14, 2)
  /// The till session it was sold in. Empty only for sales made before till sessions existed.
  tillSessionId   String?  @db.Char(36)
  tillSession     TillSession? @relation(fields: [tillSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  lines           SaleLine[]
  payments        Payment[]
  receiptPrints   SaleReceiptPrint[]
  cancellation    SaleCancellation?
  refunds         Refund[]
  accountEntries  CustomerAccountEntry[]
  repaymentParts  RepaymentAllocation[]
  approvalUses    ApprovalUse[]

  @@unique([businessId, requestId])
  @@unique([terminalId, sequence])
  @@unique([businessId, receiptNumber])
  @@index([businessId, createdAt])
  @@index([businessId, cashierUserId, createdAt])
  @@index([tillSessionId])
  @@index([customerId, createdAt])
  @@map("sale")
}

/// One product on a sale, with copies of everything as it was: unit, conversion, price, tax, cost. Add-only.
model SaleLine {
  id             String   @id @default(uuid()) @db.Char(36)
  businessId     String   @db.Char(36)
  business       Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId         String   @db.Char(36)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String   @db.Char(36)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId  String   @db.Char(36)
  productName    String   @db.VarChar(120)
  unitName       String   @db.VarChar(40)
  unitFactor     Decimal  @db.Decimal(12, 3)
  /// How many of the chosen unit, and the same amount in base units.
  quantity       Decimal  @db.Decimal(16, 3)
  baseQuantity   Decimal  @db.Decimal(16, 3)
  /// The preset price of one unit (tax included) and quantity × price rounded to the kobo.
  unitPrice      Decimal  @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)
  /// This line's share of the sale's discount. What was charged for the line is lineTotal less this.
  discountAmount Decimal  @default(0) @db.Decimal(14, 2)
  /// Whether the product was taxable, the rate applied (0 if not), and the tax inside what was charged.
  taxable        Boolean
  taxRatePercent Decimal  @db.Decimal(5, 2)
  taxAmount      Decimal  @db.Decimal(14, 2)
  /// Average cost of one BASE unit at the moment of sale, and the cost of this line.
  baseUnitCost   Decimal  @db.Decimal(16, 4)
  lineCost       Decimal  @db.Decimal(16, 2)
  /// Where the goods were taken from.
  locationId     String   @db.Char(36)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationName   String   @db.VarChar(60)

  @@unique([saleId, lineNumber])
  @@index([productId])
  @@map("sale_line")
}

/// What kind of money a payment method is. CASH is what ends up in the till drawer.
enum PaymentKind {
  CASH
  TRANSFER
  POS
}

/// A way customers pay, from the business's own list (SPEC C46): "Cash", "Transfer – GTBank",
/// "POS – Moniepoint"… Managed by the admin. Never deleted once it exists; switched off instead.
model PaymentMethod {
  id            String      @id @default(uuid()) @db.Char(36)
  businessId    String      @db.Char(36)
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String      @db.VarChar(60)
  /// Fixed when the method is created.
  kind          PaymentKind
  /// True for the "Cash" every business starts with, which cannot be switched off.
  builtIn       Boolean     @default(false)
  deactivatedAt DateTime?   @db.DateTime(3)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)

  payments      Payment[]
  refunds       Refund[]
  repayments    Repayment[]

  @@unique([businessId, name])
  @@map("payment_method")
}

/// Money received for a sale. A sale has one payment, or several when it is split. Add-only.
model Payment {
  id               String        @id @default(uuid()) @db.Char(36)
  businessId       String        @db.Char(36)
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId           String        @db.Char(36)
  sale             Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  methodId         String        @db.Char(36)
  method           PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Copies of the method's name and kind as they were.
  methodName       String        @db.VarChar(60)
  kind             PaymentKind
  /// Transfer and POS: the bank or terminal reference, if the cashier noted one.
  reference        String?       @db.VarChar(60)
  /// The till session the money was taken in.
  tillSessionId    String?       @db.Char(36)
  tillSession      TillSession?  @relation(fields: [tillSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// What this payment settles of the sale.
  amount           Decimal       @db.Decimal(14, 2)
  /// Cash only: what the customer handed over, and the change given back (tendered − amount).
  tendered         Decimal?      @db.Decimal(14, 2)
  changeGiven      Decimal?      @db.Decimal(14, 2)
  receivedByUserId String?
  receivedByName   String
  createdAt        DateTime      @default(now()) @db.DateTime(3)

  refund           Refund?

  @@index([saleId])
  @@index([businessId, createdAt])
  @@index([tillSessionId])
  @@map("payment")
}

/// Each time a receipt is printed. The first is the original; later ones are reprints. Add-only.
model SaleReceiptPrint {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId          String   @db.Char(36)
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  printedByUserId String?
  printedByName   String
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([saleId])
  @@map("sale_receipt_print")
}

enum DocumentKind {
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_COUNT
  STOCK_ADJUSTMENT
  TILL_SESSION
  REPAYMENT
}

/// The number the next document of each kind will get in a business (deliveries, transfers,
/// counts, adjustments). Only ever increased, inside the transaction that saves the document.
/// Kept in rows of its own, NOT on the business record: locking the business record for a
/// whole stock transaction made every sale in the business wait, and could deadlock with one.
model DocumentCounter {
  id         String       @id @default(uuid()) @db.Char(36)
  businessId String       @db.Char(36)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind       DocumentKind
  next       Int          @default(1)

  @@unique([businessId, kind])
  @@map("document_counter")
}

/// One stretch of selling at one checkout terminal — one cash drawer — from opening it with a
/// float to closing it with a count. Sales can only be made at a terminal whose till is open.
/// Add-only: it is open for as long as it has no TillSessionClose.
model TillSession {
  id             String   @id @default(uuid()) @db.Char(36)
  businessId     String   @db.Char(36)
  business       Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 1, 2, 3… within the business; shown as TS-000012.
  number         Int
  terminalId     String   @db.Char(36)
  terminal       Terminal @relation(fields: [terminalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terminalCode   String   @db.VarChar(6)
  /// Cash put in the drawer at the start, for giving change.
  openingFloat   Decimal  @db.Decimal(14, 2)
  /// How the float was counted, note by note, if the person used "Count by notes" (see src/lib/cash-notes.ts).
  floatBreakdown String?  @db.VarChar(300)
  openedByUserId String?
  openedByName   String
  openedAt       DateTime @default(now()) @db.DateTime(3)

  sales          Sale[]
  payments       Payment[]
  refunds        Refund[]
  repayments     Repayment[]
  close          TillSessionClose?
  recounts       TillSessionRecount[]

  @@unique([businessId, number])
  @@index([terminalId, openedAt])
  @@index([businessId, openedAt])
  @@map("till_session")
}

/// The closing of a till session: the cash counted in the drawer against what should be
/// there (float + cash taken). One per session. Add-only.
model TillSessionClose {
  id             String      @id @default(uuid()) @db.Char(36)
  businessId     String      @db.Char(36)
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionId      String      @unique @db.Char(36)
  session        TillSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expectedCash   Decimal     @db.Decimal(14, 2)
  countedCash    Decimal     @db.Decimal(14, 2)
  /// Counted minus expected: negative means cash is short.
  difference     Decimal     @db.Decimal(14, 2)
  /// How the cash was counted, note by note, if "Count by notes" was used.
  breakdown      String?     @db.VarChar(300)
  note           String?     @db.VarChar(300)
  closedByUserId String?
  closedByName   String
  createdAt      DateTime    @default(now()) @db.DateTime(3)

  @@map("till_session_close")
}

/// A manager's or admin's own count of a till's cash after it was closed, on the same business
/// day (SPEC C52). A separate record each time: the cashier's closing count is never replaced.
/// Add-only.
model TillSessionRecount {
  id                String      @id @default(uuid()) @db.Char(36)
  businessId        String      @db.Char(36)
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionId         String      @db.Char(36)
  session           TillSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// What should be there: the figure stored when the till was closed.
  expectedCash      Decimal     @db.Decimal(14, 2)
  countedCash       Decimal     @db.Decimal(14, 2)
  /// Counted minus expected: negative means cash is short.
  difference        Decimal     @db.Decimal(14, 2)
  /// How the cash was counted, note by note, if "Count by notes" was used.
  breakdown         String?     @db.VarChar(300)
  note              String      @db.VarChar(300)
  recountedByUserId String?
  recountedByName   String
  createdAt         DateTime    @default(now()) @db.DateTime(3)

  @@index([sessionId, createdAt])
  @@map("till_session_recount")
}

/// The cancelling of a whole sale by an admin or manager, on the day it was made (SPEC C48).
/// The sale itself is never changed: this row is what marks it as cancelled, and there can be
/// only one per sale. Its stock comes back by new movements and its payments are refunded by
/// Refund rows, all in the same transaction. Add-only.
model SaleCancellation {
  id                String   @id @default(uuid()) @db.Char(36)
  businessId        String   @db.Char(36)
  business          Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId            String   @unique @db.Char(36)
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Why it was cancelled.
  note              String   @db.VarChar(300)
  cancelledByUserId String?
  cancelledByName   String
  createdAt         DateTime @default(now()) @db.DateTime(3)

  refunds           Refund[]

  @@index([businessId, createdAt])
  @@map("sale_cancellation")
}

/// Money given back for one payment of a cancelled sale: the opposite of that payment, by
/// the same method. A cash refund comes out of the till that is open at the time. Add-only.
model Refund {
  id               String           @id @default(uuid()) @db.Char(36)
  businessId       String           @db.Char(36)
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId           String           @db.Char(36)
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancellationId   String           @db.Char(36)
  cancellation     SaleCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// The payment being given back. A payment is refunded at most once.
  paymentId        String           @unique @db.Char(36)
  payment          Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  methodId         String           @db.Char(36)
  method           PaymentMethod    @relation(fields: [methodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  methodName       String           @db.VarChar(60)
  kind             PaymentKind
  amount           Decimal          @db.Decimal(14, 2)
  /// The till session the cash came out of. Always set for a cash refund.
  tillSessionId    String?          @db.Char(36)
  tillSession      TillSession?     @relation(fields: [tillSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refundedByUserId String?
  refundedByName   String
  createdAt        DateTime         @default(now()) @db.DateTime(3)

  @@index([saleId])
  @@index([tillSessionId])
  @@index([businessId, createdAt])
  @@map("refund")
}

/// Someone the business sells to by name (SPEC C49). Belongs to one business. Never deleted
/// once it exists; taken out of use instead. `balance` is what the customer owes: a running
/// total that must always equal the sum of their account entries.
model Customer {
  id            String    @id @default(uuid()) @db.Char(36)
  businessId    String    @db.Char(36)
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String    @db.VarChar(120)
  /// Digits only, with an optional leading "+". Unique within the business.
  phone         String    @db.VarChar(30)
  address       String?   @db.VarChar(200)
  city          String?   @db.VarChar(60)
  state         String?   @db.VarChar(60)
  /// The most this customer may owe. Empty means this customer cannot buy on credit (SPEC C55).
  creditLimit   Decimal?  @db.Decimal(14, 2)
  /// What the customer owes now. Never negative: there are no advance deposits (SPEC C54).
  balance       Decimal   @default(0) @db.Decimal(14, 2)
  deactivatedAt DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  sales         Sale[]
  entries       CustomerAccountEntry[]
  limitChanges  CreditLimitChange[]
  repayments    Repayment[]

  @@unique([businessId, phone])
  @@index([businessId, name])
  @@map("customer")
}

enum AccountEntryType {
  /// Part of a sale put on the account: the customer owes more.
  CREDIT_SALE
  /// Money received against the debt: the customer owes less.
  REPAYMENT
  /// A credit sale was cancelled: what it added is taken off again.
  SALE_CANCELLED
}

/// One line of a customer's account. Add-only: the history of a debt is never rewritten.
model CustomerAccountEntry {
  id              String           @id @default(uuid()) @db.Char(36)
  businessId      String           @db.Char(36)
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId      String           @db.Char(36)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type            AccountEntryType
  /// Positive when the customer owes more, negative when they owe less. Never zero.
  amount          Decimal          @db.Decimal(14, 2)
  /// What the customer owed straight after this entry.
  balanceAfter    Decimal          @db.Decimal(14, 2)
  /// What it belongs to.
  saleId          String?          @db.Char(36)
  sale            Sale?            @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repaymentId     String?          @unique @db.Char(36)
  repayment       Repayment?       @relation(fields: [repaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// The receipt or repayment number, for reading.
  documentNumber  String           @db.VarChar(30)
  note            String?          @db.VarChar(300)
  createdByUserId String?
  createdByName   String
  createdAt       DateTime         @default(now()) @db.DateTime(3)

  @@index([customerId, createdAt])
  @@index([saleId])
  @@map("customer_account_entry")
}

/// Every change of a customer's credit limit. Add-only.
model CreditLimitChange {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId      String   @db.Char(36)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Empty means "no credit".
  oldLimit        Decimal? @db.Decimal(14, 2)
  newLimit        Decimal? @db.Decimal(14, 2)
  changedByUserId String?
  changedByName   String
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([customerId, createdAt])
  @@map("credit_limit_change")
}

/// Money received from a customer against what they owe. Add-only.
model Repayment {
  id               String        @id @default(uuid()) @db.Char(36)
  businessId       String        @db.Char(36)
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Made up by the browser, so the same repayment is never recorded twice.
  requestId        String        @db.Char(36)
  /// 1, 2, 3… within the business; shown as RP-000012.
  number           Int
  customerId       String        @db.Char(36)
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerName     String        @db.VarChar(120)
  amount           Decimal       @db.Decimal(14, 2)
  methodId         String        @db.Char(36)
  method           PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  methodName       String        @db.VarChar(60)
  kind             PaymentKind
  reference        String?       @db.VarChar(60)
  /// The till session the cash went into. Always set for cash.
  tillSessionId    String?       @db.Char(36)
  tillSession      TillSession?  @relation(fields: [tillSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  note             String?       @db.VarChar(300)
  receivedByUserId String?
  receivedByName   String
  createdAt        DateTime      @default(now()) @db.DateTime(3)

  entry            CustomerAccountEntry?
  allocations      RepaymentAllocation[]

  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([customerId, createdAt])
  @@index([tillSessionId])
  @@index([businessId, createdAt])
  @@map("repayment")
}

/// Which credit sale a repayment (or part of it) pays off. Add-only. What is still owed on
/// a sale is its credit amount less the allocations made to it.
model RepaymentAllocation {
  id          String    @id @default(uuid()) @db.Char(36)
  businessId  String    @db.Char(36)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repaymentId String    @db.Char(36)
  repayment   Repayment @relation(fields: [repaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId      String    @db.Char(36)
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amount      Decimal   @db.Decimal(14, 2)

  @@unique([repaymentId, saleId])
  @@index([saleId])
  @@map("repayment_allocation")
}

enum ApprovalKind {
  /// An extra discount on a sale.
  DISCOUNT
  /// Letting a customer go over their credit limit on a sale.
  CREDIT_OVER_LIMIT
}

enum ApprovalMethod {
  /// A manager or admin typed their own username and password on the cashier's screen.
  AT_SCREEN
  /// The person making the sale may approve such things themselves.
  OWN_SALE
  /// The cashier sent a request and a manager or admin approved it from their own computer.
  REMOTE
}

enum ApprovalRequestOutcome {
  APPROVED
  REFUSED
  /// Taken back by the person who asked.
  WITHDRAWN
}

/// A cashier's request for approval, waiting to be answered from a manager's own computer.
/// Add-only: it is waiting while it has no decision row and its time has not run out.
model ApprovalRequest {
  id                String                   @id @default(uuid()) @db.Char(36)
  businessId        String                   @db.Char(36)
  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind              ApprovalKind
  saleRequestId     String                   @db.Char(36)
  fingerprint       String                   @db.Char(64)
  amount            Decimal                  @db.Decimal(14, 2)
  basis             Decimal                  @db.Decimal(14, 2)
  reason            String?                  @db.VarChar(300)
  /// What the approver is shown, as it was when asked: the items, and the customer if any (JSON text).
  details           String                   @db.Text
  requestedByUserId String?
  requestedByName   String
  createdAt         DateTime                 @default(now()) @db.DateTime(3)
  expiresAt         DateTime                 @db.DateTime(3)

  decision          ApprovalRequestDecision?
  approval          Approval?

  @@index([businessId, createdAt])
  @@map("approval_request")
}

/// The one answer to a request. Add-only; written first in its transaction (it is the lock).
model ApprovalRequestDecision {
  id              String                 @id @default(uuid()) @db.Char(36)
  businessId      String                 @db.Char(36)
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestId       String                 @unique @db.Char(36)
  request         ApprovalRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outcome         ApprovalRequestOutcome
  note            String?                @db.VarChar(300)
  decidedByUserId String?
  decidedByName   String
  createdAt       DateTime               @default(now()) @db.DateTime(3)

  @@map("approval_request_decision")
}

/// A manager's or admin's yes to one particular thing on one particular sale (SPEC §4.5).
/// It is tied to the sale's own ID and to a fingerprint of exactly what was approved, can be
/// used once (ApprovalUse), and lapses ten minutes after it was given. Add-only.
model Approval {
  id                String         @id @default(uuid()) @db.Char(36)
  businessId        String         @db.Char(36)
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind              ApprovalKind
  method            ApprovalMethod
  /// The ID the checkout gave the sale before sending it. The approval is good for that sale only.
  saleRequestId     String         @db.Char(36)
  /// A fingerprint of exactly what was approved (the items and the discount, or the customer
  /// and the credit). If any of it changes, the fingerprint no longer matches.
  fingerprint       String         @db.Char(64)
  /// The discount, or the amount put on credit.
  amount            Decimal        @db.Decimal(14, 2)
  /// What the approver was shown beside it: the sale's total before the discount, or what
  /// the customer would owe afterwards.
  basis             Decimal        @db.Decimal(14, 2)
  reason            String?        @db.VarChar(300)
  requestedByUserId String?
  requestedByName   String
  approvedByUserId  String?
  approvedByName    String
  createdAt         DateTime       @default(now()) @db.DateTime(3)
  expiresAt         DateTime       @db.DateTime(3)
  /// The request this answers, when it was approved from the manager's own computer.
  requestId         String?        @unique @db.Char(36)
  request           ApprovalRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  use               ApprovalUse?

  @@index([businessId, createdAt])
  @@index([businessId, saleRequestId])
  @@map("approval")
}

/// The one use of an approval: the sale it was spent on. Add-only.
model ApprovalUse {
  id         String   @id @default(uuid()) @db.Char(36)
  businessId String   @db.Char(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvalId String   @unique @db.Char(36)
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleId     String   @db.Char(36)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([saleId])
  @@map("approval_use")
}
