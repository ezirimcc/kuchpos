# Settings for KuchPos on the hosting server.
# Save a copy of this file as ".env" in the application folder and fill in the values.
# Keep that file private: it must never be placed inside public_html.
# The LIVE site and the TEST site each have their own .env, database and secret.

# The database created in DirectAdmin, as mysql://USER:PASSWORD@localhost:3306/DATABASE
# If the password contains any of  @ : / ? # %  choose a password without them (letters and numbers only).
DATABASE_URL="mysql://DATABASE_USER:DATABASE_PASSWORD@localhost:3306/DATABASE_NAME"

# A long random value that signs the login cookies. Never reuse the one from another site.
BETTER_AUTH_SECRET="PASTE-A-LONG-RANDOM-VALUE-HERE"

# The address people type to reach the app: https://pos.kuch99.com (live) or https://test.kuch99.com (test).
BETTER_AUTH_URL="https://pos.kuch99.com"

# "test" shows the yellow TEST banner on every page. Remove this line on the live site.
KUCHPOS_ENVIRONMENT="test"

# --- Backups (C79) -------------------------------------------------------------
# The passphrase that locks every backup copy. At least 20 characters. Keep a copy in your
# password manager: WITHOUT IT NO BACKUP CAN BE OPENED. Never change it once backups exist.
BACKUP_PASSPHRASE="CHOOSE-A-LONG-PASSPHRASE"
# The Backblaze B2 application key made for the KuchPos backups bucket (keyID and applicationKey).
B2_KEY_ID="PASTE-THE-KEY-ID"
B2_APPLICATION_KEY="PASTE-THE-APPLICATION-KEY"
# For a restore (drill or real): a spare database with "restore" in its name. A restore EMPTIES it first.
RESTORE_DATABASE_URL="mysql://DATABASE_USER:DATABASE_PASSWORD@localhost:3306/RESTORE_DATABASE_NAME"
# Optional: which backup to restore, e.g. nightly/kuchpos-live-20261020T2330Z-nightly.kbk (empty = the newest).
# RESTORE_FILE=""

# --- Only once, on a NEW live site: the first owner ("Run JS script" → create-owner) -------
# Remove both lines after the owner has been created.
# FIRST_OWNER_NAME="Your full name"
# FIRST_OWNER_USERNAME="yourname"

# --- Only for the TEST site: sample data -------------------------------------
# Password for the sample users created by "npm run seed". Choose your own.
SEED_PASSWORD="CHOOSE-A-PASSWORD-FOR-THE-SAMPLE-USERS"
# Type the database name here to allow "npm run seed" to WIPE that database and load sample data.
SEED_CONFIRM="DATABASE_NAME"
