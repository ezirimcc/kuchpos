// KuchPos database structure.
// Change this file, then run `npm run db:migrate` to create a migration. Never edit an applied migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// OWNER sits above all businesses. The other five roles belong to exactly one business.
enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
  STOREKEEPER
}

/// One independent shop. Everything a shop owns carries its businessId.
model Business {
  id            String    @id @default(uuid()) @db.Char(36)
  name          String
  /// Lower-cased name, used to stop two businesses having the same name.
  nameKey       String    @unique
  /// Set when an owner deactivates the business: nobody can sign in to it, records are kept.
  deactivatedAt DateTime? @db.DateTime(3)
  /// Staff are signed out after this many minutes without using the app (5 to 480; database CHECK).
  idleSignOutMinutes Int  @default(30)
  /// Tax rate in percent (0 to 100; database CHECK). Prices already include tax.
  taxRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  /// Lines printed at the top of every receipt, under the business name (address, phone…).
  receiptHeader String?   @db.VarChar(500)
  /// Lines printed at the bottom of every receipt (thank-you note, return policy…).
  receiptFooter String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  users         User[]
  activityLogs  ActivityLog[]
  openedIn      Session[]
  locations     Location[]
  terminals     Terminal[]
  products      Product[]
  productUnits  ProductUnit[]
  priceChanges  PriceChange[]
  taxRateChanges TaxRateChange[]

  @@map("business")
}

/// A person who can sign in. Core columns are required by the Better Auth login library.
model User {
  id              String    @id
  name            String
  /// Not used for sign-in or contact; the login library requires a unique value here.
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  /// Sign-in name. Unique across the whole system, always lower case.
  username        String    @unique
  displayUsername String?

  role            Role
  /// Empty for owners; set for everyone else (enforced by a database CHECK).
  businessId      String?   @db.Char(36)
  /// onUpdate must be Restrict: MariaDB refuses a CHECK on a column whose foreign key cascades.
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Set when the account is disabled. Accounts are never deleted.
  disabledAt      DateTime? @db.DateTime(3)

  sessions        Session[]
  accounts        Account[]
  activityLogs    ActivityLog[]
  priceChanges    PriceChange[]
  taxRateChanges  TaxRateChange[]

  @@index([businessId])
  @@map("user")
}

/// A signed-in browser. Core columns are required by the login library.
model Session {
  id               String    @id
  expiresAt        DateTime  @db.DateTime(3)
  token            String    @unique
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)
  ipAddress        String?
  userAgent        String?   @db.Text
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When this session last made a request. Used for automatic sign-out after inactivity.
  lastActiveAt     DateTime  @default(now()) @db.DateTime(3)

  /// For owners only: the business they currently have open.
  activeBusinessId String?   @db.Char(36)
  activeBusiness   Business? @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("session")
}

/// A way of signing in for a user. KuchPos uses only "credential" (username + password).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?
  /// Scrambled (hashed) password. Never readable.
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Required by the login library; unused by KuchPos today.
model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}

/// Counts recent requests per visitor so that password guessing can be slowed down.
/// Managed entirely by the login library.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Who did what and when. Add-only: database triggers refuse changes and deletions.
model ActivityLog {
  id          String    @id @default(uuid()) @db.Char(36)
  /// The business the event belongs to. Empty for system-level events (owners, creating businesses).
  businessId  String?   @db.Char(36)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  /// Copies of the actor's name and role at the time, so the log still reads correctly later.
  actorName   String
  actorRole   Role?
  /// Machine-readable event name, e.g. "staff.created".
  action      String
  /// Plain-language sentence shown on screen.
  summary     String    @db.VarChar(500)
  targetType  String?
  targetId    String?
  details     Json?
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([businessId, createdAt])
  @@map("activity_log")
}

enum LocationKind {
  SHELF
  STOREROOM
}

/// A place inside one business where stock is kept. Every business starts with a Shelf and a Storeroom.
model Location {
  id         String       @id @default(uuid()) @db.Char(36)
  businessId String       @db.Char(36)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name       String       @db.VarChar(60)
  kind       LocationKind
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)

  @@unique([businessId, name])
  @@map("location")
}

enum PaperWidth {
  MM58
  MM80
}

/// A checkout computer. Its short code starts every receipt number it produces.
model Terminal {
  id            String     @id @default(uuid()) @db.Char(36)
  businessId    String     @db.Char(36)
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Short code, capital letters and digits, unique within the business (e.g. "T1"). Never changes.
  code          String     @db.VarChar(6)
  name          String     @db.VarChar(60)
  paperWidth    PaperWidth @default(MM80)
  deactivatedAt DateTime?  @db.DateTime(3)
  createdAt     DateTime   @default(now()) @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @db.DateTime(3)

  @@unique([businessId, code])
  @@map("terminal")
}

/// Something the business sells. Stock is always counted in the product's base unit.
model Product {
  id             String    @id @default(uuid()) @db.Char(36)
  businessId     String    @db.Char(36)
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name           String    @db.VarChar(120)
  /// Optional short code used by the shop. Unique within the business when present.
  code           String?   @db.VarChar(40)
  /// Optional barcode. Unique within the business when present.
  barcode        String?   @db.VarChar(64)
  /// True for goods sold by weight or volume (2.5 kg); false for goods sold only in whole units.
  /// Fixed when the product is created.
  allowsFraction Boolean
  /// Unticked products carry no tax whatever the business's tax rate.
  taxable        Boolean   @default(true)
  /// Set when the product is taken out of use. Products are never deleted.
  deactivatedAt  DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  units          ProductUnit[]
  priceChanges   PriceChange[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, barcode])
  @@map("product")
}

/// A unit a product is bought or sold in (single, pack, carton, kg, 50 kg bag…), with its own price.
/// The name and conversion of a unit never change: to change them, the unit is retired and a new one added.
model ProductUnit {
  id          String    @id @default(uuid()) @db.Char(36)
  businessId  String    @db.Char(36)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId   String    @db.Char(36)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name        String    @db.VarChar(40)
  /// How many base units one of this unit contains. The base unit itself is 1.
  factor      Decimal   @db.Decimal(12, 3)
  isBase      Boolean   @default(false)
  forSale     Boolean   @default(true)
  forPurchase Boolean   @default(true)
  /// Selling price in Naira, tax included. Empty when the unit is not for sale.
  price       Decimal?  @db.Decimal(14, 2)
  /// The unit's name while it is in use, empty once retired. Stops two in-use units of one
  /// product sharing a name while still allowing a retired "carton" beside a new "carton".
  activeName  String?   @db.VarChar(40)
  retiredAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  priceChanges PriceChange[]

  @@unique([productId, activeName])
  @@index([businessId])
  @@map("product_unit")
}

/// Every change of a selling price. Add-only: database triggers refuse changes and deletions.
model PriceChange {
  id              String      @id @default(uuid()) @db.Char(36)
  businessId      String      @db.Char(36)
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId       String      @db.Char(36)
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productUnitId   String      @db.Char(36)
  productUnit     ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Copy of the unit's name at the time.
  unitName        String      @db.VarChar(40)
  /// Empty when this is the unit's first price.
  oldPrice        Decimal?    @db.Decimal(14, 2)
  /// Empty when the price was removed because the unit stopped being for sale.
  newPrice        Decimal?    @db.Decimal(14, 2)
  changedByUserId String?
  changedBy       User?       @relation(fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByName   String
  createdAt       DateTime    @default(now()) @db.DateTime(3)

  @@index([productId, createdAt])
  @@map("price_change")
}

/// Every change of a business's tax rate. Add-only: database triggers refuse changes and deletions.
model TaxRateChange {
  id              String   @id @default(uuid()) @db.Char(36)
  businessId      String   @db.Char(36)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  oldRatePercent  Decimal  @db.Decimal(5, 2)
  newRatePercent  Decimal  @db.Decimal(5, 2)
  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByName   String
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, createdAt])
  @@map("tax_rate_change")
}
